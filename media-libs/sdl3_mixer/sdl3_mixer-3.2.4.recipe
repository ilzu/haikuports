SUMMARY="Simple Direct Media Layer Mixing Library"
DESCRIPTION="SDL_mixer is an audio management library. It provides decoding \
of many popular audio file formats, mixing, various DSP processing \
effects and positional audio."
HOMEPAGE="https://github.com/libsdl-org/SDL_mixer"
COPYRIGHT="1997-2026 Sam Lantinga"
LICENSE="Zlib"
REVISION="1"
SOURCE_URI="https://github.com/libsdl-org/SDL_mixer/archive/refs/tags/release-$portVersion.tar.gz"
CHECKSUM_SHA256="f2ea848ccdf2f394cd4973ee0f6c482e04511044695cccfd46bab6dcd7f780aa"
SOURCE_DIR="SDL_mixer-release-$portVersion"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

libVersion="0.2.4"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"

PROVIDES="
	sdl3_mixer$secondaryArchSuffix = $portVersion compat >= 3.0
	lib:libSDL3_mixer$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku${secondaryArchSuffix}
	lib:libogg$secondaryArchSuffix
	lib:libopus$secondaryArchSuffix
	lib:libvorbisfile$secondaryArchSuffix
	lib:libflac$secondaryArchSuffix
	lib:libSDL3$secondaryArchSuffix
	lib:libgme$secondaryArchSuffix
	lib:libxmp$secondaryArchSuffix
	lib:libmpg123$secondaryArchSuffix
	lib:libfluidsynth$secondaryArchSuffix >= 3.0
	lib:libwavpack$secondaryArchSuffix
	cmd:flac
	"

PROVIDES_devel="
	sdl3_mixer${secondaryArchSuffix}_devel = $portVersion compat >= 3.0
	devel:libSDL3_mixer$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	sdl3_mixer$secondaryArchSuffix == $portVersion base
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libogg$secondaryArchSuffix
	devel:libopus$secondaryArchSuffix
	devel:libvorbisfile$secondaryArchSuffix
	devel:libFLAC$secondaryArchSuffix
	devel:libSDL3$secondaryArchSuffix
	devel:libgme$secondaryArchSuffix
	devel:libxmp$secondaryArchSuffix
	devel:libmpg123$secondaryArchSuffix
	devel:libfluidsynth$secondaryArchSuffix >= 3.0
	devel:libwavpack$secondaryArchSuffix
	cmd:flac
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:gcc$secondaryArchSuffix
	cmd:ld$secondaryArchSuffix
	cmd:ninja
	cmd:pkg_config$secondaryArchSuffix
	"

BUILD()
{
	cmake . -Bbuild -GNinja $cmakeDirArgs \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=Release -DSDLMIXER_EXAMPLES=Off
	ninja -C build
}

INSTALL()
{
	ninja -C build install

	rm -rf $dataDir

	prepareInstalledDevelLibs libSDL3_mixer

	fixPkgconfig

	packageEntries devel \
		$developDir \
		$libDir/cmake
}
